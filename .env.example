# ------------------------------------------------------------------
# Database — Postgres bersama dengan pintarpy.
# Container-nya didefinisikan di docker-compose.yml repo ini
# (jalankan: docker compose up -d db)
#
# Dari host  : @localhost:5432
# Dari docker: @shared-postgres:5432
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenio_pintarpy"

# ------------------------------------------------------------------
# better-auth
# BETTER_AUTH_SECRET WAJIB sama persis dengan milik pintarpy
# supaya sesi bisa dipakai bersama. Generate: openssl rand -base64 32
# ------------------------------------------------------------------
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Redis (rate limiter)
REDIS_URL=""

# ------------------------------------------------------------------
# Bot WhatsApp lewat go-whatsapp-web-multidevice (GOWA)
# WA_WEBHOOK_SECRET harus sama dengan Secret di pengaturan webhook GOWA.
# ------------------------------------------------------------------
WA_API_URL=""
# Kredensial APP_BASIC_AUTH di server GOWA, format user:pass
WA_API_AUTH=""
WA_WEBHOOK_SECRET=""
# Nomor bot tanpa tanda +, untuk link wa.me di dashboard
WA_BOT_NUMBER=""
# Opsional, batas panggilan LLM per akun per hari (default 100)
WA_LLM_QUOTA_HARIAN=""

# ------------------------------------------------------------------
# Gateway LLM (OpenAI-compatible), dipakai bot untuk mengurai pesan
# ------------------------------------------------------------------
AI_ZENIO_GATEWAY=""
AI_ZENIO_API_KEY=""
# Opsional, daftar model dipisah koma; kosong = default di lib/llm.ts
AI_MODELS=""
